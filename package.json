{
  "name": "marketing-lab-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.hysmarcos/marketing-lab-mcp",
  "description": "MCP server with marketing decision tools: A/B tests, incrementality, budget allocation and more.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "marketing",
    "ab-testing",
    "attribution",
    "marketing-mix-model",
    "rfm",
    "claude"
  ],
  "homepage": "https://hysmarcos.github.io/marketing-lab-mcp/",
  "bugs": {
    "url": "https://github.com/hysmarcos/marketing-lab-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hysmarcos/marketing-lab-mcp.git"
  },
  "type": "module",
  "license": "MIT AND CC-BY-NC-SA-4.0",
  "author": "Marcos Hoyos",
  "bin": {
    "marketing-lab-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "data/README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "start:stdio": "tsx src/runtimes/stdio.ts",
    "dev:worker": "wrangler dev",
    "build": "esbuild src/runtimes/stdio.ts --bundle --platform=node --format=esm --target=node20 --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=dist/stdio.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
